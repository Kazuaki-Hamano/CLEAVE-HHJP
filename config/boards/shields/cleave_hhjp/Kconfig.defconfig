if SHIELD_CLEAVE_HHJP_LEFT

config ZMK_KEYBOARD_NAME
	default "CLEAVE HHJP"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
	default 1

config BT_MAX_CONN
	default 5

endif

if SHIELD_CLEAVE_HHJP_RIGHT

# The physical trackpad is on the peripheral; input-split forwards it to the left.
config ZMK_POINTING
	default y

config SPI
	default y

config BT_GATT_CLIENT
	default y

endif

if SHIELD_CLEAVE_HHJP_LEFT || SHIELD_CLEAVE_HHJP_RIGHT

config ZMK_SPLIT
	default y

endif
