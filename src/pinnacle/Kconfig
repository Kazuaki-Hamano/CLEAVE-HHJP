menuconfig CLEAVE_INPUT_PINNACLE
    bool "Cirque Pinnacle trackpads"
    default y
    depends on GPIO
    depends on SPI || I2C
    depends on INPUT
    depends on DT_HAS_CLEAVE_PINNACLE_ENABLED
    help
      Enable driver for Cirque Pinnacle trackpads

if CLEAVE_INPUT_PINNACLE

config CLEAVE_INPUT_PINNACLE_INIT_PRIORITY
    int "Cirque Pinnacle initialization priority"
    default INPUT_INIT_PRIORITY

endif
